# Copiez ce fichier en `.env.e2e` (ignoré par git) et complétez.
#
# Le compte doit avoir le rôle super_admin : la suite va dans l'administration
# (tenants, utilisateurs, modèles, e-mails). Un compte de test DEDIE est
# preferable : la suite cree puis supprime un modele IA.
PILOT_BASE_URL=https://pilot.orpailleur-software.fr
PILOT_EMAIL=e2e@orpailleur.com
PILOT_PASSWORD=changez-moi
